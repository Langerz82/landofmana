; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Land of Mana"
config/description="Godot 4 port of the Land of Mana / Retro RPG Online 2 browser client."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://assets/img/common/favicon.png"

[autoload]

Config="*res://scripts/core/config.gd"
GameData="*res://scripts/core/game_data.gd"
Game="*res://scripts/core/game_state.gd"

[display]

window/size/viewport_width=1024
window/size/viewport_height=768

[gui]

theme/custom_font="res://assets/fonts/advocut-webfont.ttf"

